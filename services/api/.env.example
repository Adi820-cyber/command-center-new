# Shared by all three API deployments.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
ALLOWED_ORIGINS=https://app.example.com
PORT=3000

# Configure exactly one database URL per process.
KPI_DATABASE_URL=
CONTROL_DATABASE_URL=
IDENTITY_DATABASE_URL=

# Required only on control/identity processes that administer logins.
SUPABASE_SECRET_KEY=

# Customer data API: enable only after the identity email flow is verified.
ENFORCE_PASSWORD_CHANGE=true

# Identity API mail delivery.
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Command Center

# Optional customer-workspace answer narration. Leave unset for deterministic answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
